# Copy to /opt/salary-prod/config/production.env and chmod 600.
# Never commit the populated file. Percent-encode DATABASE_URL credentials.
POSTGRES_DB=salary
POSTGRES_USER=salary_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
DATABASE_URL=postgresql+psycopg2://salary_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/salary

SECRET_SALT=REPLACE_WITH_THE_EXISTING_RENDER_VALUE
SESSION_SECRET=REPLACE_WITH_THE_EXISTING_RENDER_VALUE
ADMIN_LOGIN=REPLACE_WITH_THE_EXISTING_RENDER_VALUE
ADMIN_PASSWORD=REPLACE_WITH_THE_EXISTING_RENDER_VALUE

ENVIRONMENT=production
AUTO_SYNC_PRODUCTION_CALENDAR=0
MAINTENANCE_MODE=0
MAX_RECEIPT_BYTES=5242880

# Compose interpolation values; these are not secrets.
APP_GIT_SHA=REPLACE_WITH_DEPLOYED_COMMIT_SHA
SERVER_NAME=sverka-mm.ru
HTTP_BIND_IP=127.0.0.1
HTTP_PORT=8080
