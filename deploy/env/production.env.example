# Template for a NEW isolated installation; never overwrite an existing production.env.
# FirstVDS secret path: /opt/salary-prod/config/production.env (permissions 0600).
# Never commit the populated file. Percent-encode DATABASE_URL credentials.
POSTGRES_DB=salary
POSTGRES_USER=salary_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
DATABASE_URL=postgresql+psycopg2://salary_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/salary

SECRET_SALT=REPLACE_WITH_ENVIRONMENT_SPECIFIC_SECRET
SESSION_SECRET=REPLACE_WITH_ENVIRONMENT_SPECIFIC_SECRET
ADMIN_LOGIN=REPLACE_WITH_ENVIRONMENT_SPECIFIC_LOGIN
ADMIN_PASSWORD=REPLACE_WITH_ENVIRONMENT_SPECIFIC_PASSWORD

ENVIRONMENT=production
AUTO_SYNC_PRODUCTION_CALENDAR=0
MAINTENANCE_MODE=0
# 15 MiB per file; explicit environment values override application defaults.
MAX_RECEIPT_BYTES=15728640

# Compose interpolation values; these are not secrets.
APP_GIT_SHA=REPLACE_WITH_DEPLOYED_COMMIT_SHA
SERVER_NAME=sverka-mm.ru
# Safe loopback defaults for a candidate, not the live TLS ingress configuration.
# See docs/VPS_RUNBOOK.md before operating an existing FirstVDS installation.
HTTP_BIND_IP=127.0.0.1
HTTP_PORT=8080
